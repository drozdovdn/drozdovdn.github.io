---
import Navigation from './Navigation.astro';
import ThemeToggle from './ThemeToggle.astro';
---

<header
  class="fixed top-0 z-50 w-full border-b border-[var(--color-border)] bg-[var(--color-bg-primary)]/80 backdrop-blur-md"
>
  <div class="mx-auto flex max-w-5xl items-center justify-between px-4 py-3 sm:px-6 lg:px-8">
    {/* Logo */}
    <a
      href="/"
      class="group flex items-center gap-1 font-mono text-sm font-semibold text-[var(--color-text-primary)] transition-colors hover:text-[var(--color-accent)]"
      aria-label="Home"
    >
      <span class="text-[var(--color-text-muted)]">drozdov</span>
      <span class="text-[var(--color-accent)]">@sec</span>
      <span class="text-[var(--color-text-muted)]">:~$</span>
    </a>

    {/* Desktop Nav */}
    <div class="hidden items-center gap-4 md:flex">
      <Navigation />
      <div class="h-5 w-px bg-[var(--color-border)]"></div>
      <ThemeToggle />
    </div>

    {/* Mobile Menu Button */}
    <div class="flex items-center gap-2 md:hidden">
      <ThemeToggle />
      <button
        id="mobile-menu-btn"
        type="button"
        class="flex h-10 w-10 items-center justify-center rounded-lg border border-[var(--color-border)] bg-[var(--color-bg-secondary)] text-[var(--color-text-secondary)] transition-colors hover:border-[var(--color-accent)] hover:text-[var(--color-accent)]"
        aria-label="Toggle menu"
        aria-expanded="false"
        aria-controls="mobile-menu"
      >
        <svg class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
          <path
            id="menu-icon"
            stroke-linecap="round"
            stroke-linejoin="round"
            d="M4 6h16M4 12h16M4 18h16"
          />
        </svg>
      </button>
    </div>
  </div>

  {/* Mobile Nav — animated via grid-template-rows */}
  <div
    id="mobile-menu"
    class="overflow-hidden border-t border-[var(--color-border)] bg-[var(--color-bg-primary)] md:hidden"
    style="max-height: 0; transition: max-height 0.25s ease-out;"
    aria-hidden="true"
  >
    <div class="px-4 py-4">
      <Navigation />
    </div>
  </div>
</header>

<script is:inline>
  (function () {
    if (window._mobileMenuInit) return;
    window._mobileMenuInit = true;

    var HAMBURGER = 'M4 6h16M4 12h16M4 18h16';
    var CLOSE = 'M6 18L18 6M6 6l12 12';

    document.addEventListener('click', function (e) {
      var btn = e.target.closest('#mobile-menu-btn');
      if (!btn) return;

      var menu = document.getElementById('mobile-menu');
      if (!menu) return;

      var isOpen = btn.getAttribute('aria-expanded') === 'true';

      if (isOpen) {
        menu.style.maxHeight = '0';
        menu.setAttribute('aria-hidden', 'true');
      } else {
        menu.style.maxHeight = menu.scrollHeight + 'px';
        menu.setAttribute('aria-hidden', 'false');
      }

      btn.setAttribute('aria-expanded', String(!isOpen));

      var icon = document.getElementById('menu-icon');
      if (icon) icon.setAttribute('d', isOpen ? HAMBURGER : CLOSE);
    });

    // Сброс меню при навигации
    document.addEventListener('astro:before-swap', function () {
      var menu = document.getElementById('mobile-menu');
      var btn = document.getElementById('mobile-menu-btn');
      var icon = document.getElementById('menu-icon');
      if (menu) { menu.style.maxHeight = '0'; menu.setAttribute('aria-hidden', 'true'); }
      if (btn) btn.setAttribute('aria-expanded', 'false');
      if (icon) icon.setAttribute('d', HAMBURGER);
    });
  })();
</script>
