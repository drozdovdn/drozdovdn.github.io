---
interface Props {
  lines: { text: string; isOutput?: boolean; delay?: number }[];
  id?: string;
}

const { lines, id = 'typing-terminal' } = Astro.props;
---

<div id={id} class="font-mono text-sm">
  {lines.map((line, i) => (
    <div
      class:list={[
        'typing-line opacity-0 mb-2.5 leading-tight',
        { 'text-[var(--color-accent)]': !line.isOutput },
        { 'text-[var(--color-accent-secondary)]': line.isOutput },
      ]}
      data-line-index={i}
    >
      {!line.isOutput && (
        <span class="mr-2 text-[var(--color-text-muted)]">{'>'}</span>
      )}
      <span class="typing-text"></span>
      <span class="typing-cursor opacity-0">_</span>
    </div>
  ))}
</div>

<script is:inline define:vars={{ lines, id }}>
  (function () {
    // Guard against duplicate listener registration when script re-runs across navigations
    var listenerKey = '_typingListener_' + id;
    if (window[listenerKey]) return;
    window[listenerKey] = true;

    function initTyping() {
      var container = document.getElementById(id);
      if (!container) return;

      var lineEls = container.querySelectorAll('.typing-line');

      // Reset state (needed when navigating back — DOM is fresh but guard anyway)
      lineEls.forEach(function (el) {
        el.style.opacity = '0';
        var t = el.querySelector('.typing-text');
        if (t) t.textContent = '';
        var c = el.querySelector('.typing-cursor');
        if (c) { c.style.opacity = '0'; c.classList.remove('animate-blink'); }
      });

      function typeLineText(el, text, charDelay) {
        charDelay = charDelay || 30;
        return new Promise(function (resolve) {
          var textEl = el.querySelector('.typing-text');
          var cursorEl = el.querySelector('.typing-cursor');
          var i = 0;
          el.style.opacity = '1';
          cursorEl.style.opacity = '1';
          cursorEl.classList.add('animate-blink');

          var interval = setInterval(function () {
            textEl.textContent += text[i];
            i++;
            if (i >= text.length) {
              clearInterval(interval);
              setTimeout(function () {
                cursorEl.style.opacity = '0';
                cursorEl.classList.remove('animate-blink');
                resolve();
              }, 200);
            }
          }, charDelay);
        });
      }

      async function runSequence() {
        for (var i = 0; i < lines.length; i++) {
          if (i > 0) await new Promise(function (r) { setTimeout(r, 400); });
          await typeLineText(lineEls[i], lines[i].text, lines[i].isOutput ? 15 : 35);
        }
        var lastCursor = lineEls[lineEls.length - 1] && lineEls[lineEls.length - 1].querySelector('.typing-cursor');
        if (lastCursor) {
          lastCursor.style.opacity = '1';
          lastCursor.classList.add('animate-blink');
        }
      }

      setTimeout(runSequence, 500);
    }

    // astro:page-load fires on both first load and after every view transition
    document.addEventListener('astro:page-load', initTyping);
  })();
</script>
