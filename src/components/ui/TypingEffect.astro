---
interface Props {
  lines: { text: string; isOutput?: boolean; delay?: number }[];
  id?: string;
}

const { lines, id = 'typing-terminal' } = Astro.props;
---

<div id={id} class="font-mono text-sm">
  {lines.map((line, i) => (
    <div
      class:list={[
        'typing-line opacity-0 mb-2.5 leading-tight',
        { 'text-[var(--color-accent)]': !line.isOutput },
        { 'text-[var(--color-accent-secondary)]': line.isOutput },
      ]}
      data-line-index={i}
      data-delay={line.delay ?? i * 800}
    >
      {!line.isOutput && (
        <span class="mr-2 text-[var(--color-text-muted)]">{'>'}</span>
      )}
      <span class="typing-text"></span>
      <span class="typing-cursor opacity-0">_</span>
    </div>
  ))}
</div>

<script is:inline define:vars={{ lines, id }}>
  (function () {
    const container = document.getElementById(id);
    if (!container) return;

    const lineEls = container.querySelectorAll('.typing-line');

    const typeLineText = (el, text, charDelay = 30) => {
      return new Promise((resolve) => {
        const textEl = el.querySelector('.typing-text');
        const cursorEl = el.querySelector('.typing-cursor');
        let i = 0;
        el.style.opacity = '1';
        cursorEl.style.opacity = '1';
        cursorEl.classList.add('animate-blink');

        const interval = setInterval(() => {
          textEl.textContent += text[i];
          i++;
          if (i >= text.length) {
            clearInterval(interval);
            setTimeout(() => {
              cursorEl.style.opacity = '0';
              cursorEl.classList.remove('animate-blink');
              resolve();
            }, 200);
          }
        }, charDelay);
      });
    };

    const runSequence = async () => {
      for (let i = 0; i < lines.length; i++) {
        const delay = lines[i].delay ?? i * 800;
        if (i > 0) await new Promise((r) => setTimeout(r, 400));
        await typeLineText(lineEls[i], lines[i].text, lines[i].isOutput ? 15 : 35);
      }
      // Show final cursor blinking
      const lastCursor = lineEls[lineEls.length - 1]?.querySelector('.typing-cursor');
      if (lastCursor) {
        lastCursor.style.opacity = '1';
        lastCursor.classList.add('animate-blink');
      }
    };

    // Start on intersection
    const observer = new IntersectionObserver(
      (entries) => {
        if (entries[0].isIntersecting) {
          observer.disconnect();
          setTimeout(runSequence, 500);
        }
      },
      { threshold: 0.3 }
    );
    observer.observe(container);
  })();
</script>
