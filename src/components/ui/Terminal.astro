---
interface Props {
  title?: string;
  class?: string;
}

const { title = '~/portfolio $', class: className = '' } = Astro.props;
---

<div
  class:list={[
    'overflow-x-auto rounded-lg border border-[var(--color-border)] bg-[var(--color-bg-secondary)]',
    className,
  ]}
>
  {/* Terminal title bar */}
  <div
    class="flex items-center gap-2 border-b border-[var(--color-border)] bg-[var(--color-bg-tertiary)] px-3 py-2 sm:px-4 sm:py-2.5"
  >
    <div class="flex gap-1.5">
      <span class="h-2.5 w-2.5 rounded-full bg-[#ef4444] sm:h-3 sm:w-3"></span>
      <span class="h-2.5 w-2.5 rounded-full bg-[#f59e0b] sm:h-3 sm:w-3"></span>
      <span class="h-2.5 w-2.5 rounded-full bg-[#22c55e] sm:h-3 sm:w-3"></span>
    </div>
    <span class="ml-2 truncate text-xs text-[var(--color-text-muted)]">{title}</span>
  </div>

  {/* Terminal body */}
  <div class="p-3 text-xs leading-relaxed sm:p-4 sm:text-sm">
    <slot />
  </div>
</div>
