---
interface Props {
  title?: string;
  class?: string;
}

const { title = '~/portfolio $', class: className = '' } = Astro.props;
---

<div
  class:list={[
    'overflow-hidden rounded-lg border border-[var(--color-border)] bg-[var(--color-bg-secondary)]',
    className,
  ]}
>
  {/* Terminal title bar */}
  <div
    class="flex items-center gap-2 border-b border-[var(--color-border)] bg-[var(--color-bg-tertiary)] px-4 py-2.5"
  >
    <div class="flex gap-1.5">
      <span class="h-3 w-3 rounded-full bg-[#ef4444]"></span>
      <span class="h-3 w-3 rounded-full bg-[#f59e0b]"></span>
      <span class="h-3 w-3 rounded-full bg-[#22c55e]"></span>
    </div>
    <span class="ml-2 text-xs text-[var(--color-text-muted)]">{title}</span>
  </div>

  {/* Terminal body */}
  <div class="p-4 text-sm leading-relaxed">
    <slot />
  </div>
</div>
