---
interface Props {
  title: string;
  subtitle?: string;
  filename?: string;
}

const { title, subtitle, filename } = Astro.props;
---

<div class="mb-8 sm:mb-12">
  {filename && (
    <span class="mb-2 block text-xs text-[var(--color-text-muted)]">
      <span class="text-[var(--color-accent)]">$</span>{' '}{filename}
    </span>
  )}
  <h1 class="text-2xl font-bold text-[var(--color-text-primary)] sm:text-3xl lg:text-4xl">
    <span class="text-[var(--color-accent)]">{'{ '}</span><span
      class="glitch-hover"
      data-text={title}>{title}</span><span class="text-[var(--color-accent)]">{' }'}</span>
  </h1>
  {subtitle && (
    <p class="mt-2 text-sm text-[var(--color-text-secondary)] sm:mt-3 sm:text-base">{subtitle}</p>
  )}
  <div class="mt-3 h-px w-20 bg-gradient-to-r from-[var(--color-accent)] to-transparent sm:mt-4 sm:w-24"></div>
</div>
