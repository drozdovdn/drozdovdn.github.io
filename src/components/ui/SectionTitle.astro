---
interface Props {
  title: string;
  subtitle?: string;
  filename?: string;
}

const { title, subtitle, filename } = Astro.props;
---

<div class="mb-12">
  {filename && (
    <span class="mb-2 block text-xs text-[var(--color-text-muted)]">
      {'// '}{filename}
    </span>
  )}
  <h1 class="text-3xl font-bold text-[var(--color-text-primary)] sm:text-4xl">
    <span class="text-[var(--color-accent)]">{'{ '}</span><span
      class="glitch-hover"
      data-text={title}>{title}</span><span class="text-[var(--color-accent)]">{' }'}</span>
  </h1>
  {subtitle && (
    <p class="mt-3 text-base text-[var(--color-text-secondary)]">{subtitle}</p>
  )}
  <div class="mt-4 h-px w-24 bg-gradient-to-r from-[var(--color-accent)] to-transparent"></div>
</div>
