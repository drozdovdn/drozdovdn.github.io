---
import BaseLayout from '../../layouts/BaseLayout.astro';
import SectionTitle from '../../components/ui/SectionTitle.astro';
import { getCollection } from 'astro:content';
import { formatDate, calculateReadTime } from '../../utils/blog';

// Get all blog posts
const allPosts = await getCollection('blog');

// Sort by date (newest first)
const posts = allPosts.sort((a, b) =>
  b.data.publishedAt.getTime() - a.data.publishedAt.getTime()
);

// Собираем все уникальные теги с подсчётом
const tagCounts = posts.reduce((acc, post) => {
  post.data.tags.forEach(tag => {
    acc[tag] = (acc[tag] || 0) + 1;
  });
  return acc;
}, {} as Record<string, number>);

const allTags = Object.keys(tagCounts).sort();
---

<BaseLayout title="Блог">
  <SectionTitle
    title="Блог"
    subtitle="Я Senior Frontend Engineer, который системно движется в сторону веб-безопасности и Go. Здесь — то, что изучаю в процессе реальных проектов: конкретные концепты с примерами кода, а не пересказ документации."
    filename="cat intel.log"
  />

  {/* Мобильный фильтр — только на маленьких экранах */}
  <div class="mb-6 lg:hidden">
    <div class="flex flex-wrap gap-2">
      <button
        data-filter="all"
        data-btn-type="mobile"
        aria-pressed="true"
        class="filter-tag rounded-full bg-[var(--color-accent)] px-2.5 py-1 text-xs font-medium text-white transition-all hover:opacity-80"
      >
        Все ({posts.length})
      </button>
      {allTags.map(tag => (
        <button
          data-filter={tag}
          data-btn-type="mobile"
          aria-pressed="false"
          class="filter-tag rounded-full bg-[var(--color-accent)]/10 px-2.5 py-1 text-xs font-medium text-[var(--color-accent)] transition-all hover:bg-[var(--color-accent)]/20"
        >
          {tag} ({tagCounts[tag]})
        </button>
      ))}
    </div>
  </div>

  {/* Основной layout: сайдбар + контент */}
  <div class="flex gap-10">

    {/* Левый сайдбар — только на десктопе */}
    <aside class="hidden lg:block w-44 shrink-0">
      <div class="sticky top-28">
        <p class="mb-3 text-[10px] font-semibold uppercase tracking-widest text-[var(--color-text-muted)]">
          // темы
        </p>
        <nav class="space-y-0.5">
          <button
            data-filter="all"
            data-btn-type="sidebar"
            aria-pressed="true"
            class="filter-tag group flex w-full items-center justify-between rounded px-3 py-2 text-sm transition-all bg-[var(--color-accent)]/10 text-[var(--color-accent)]"
          >
            <span class="font-medium">Все статьи</span>
            <span class="rounded-full bg-[var(--color-accent)]/20 px-1.5 py-0.5 text-[10px] font-bold tabular-nums">
              {posts.length}
            </span>
          </button>

          {allTags.map(tag => (
            <button
              data-filter={tag}
              data-btn-type="sidebar"
              aria-pressed="false"
              class="filter-tag group flex w-full items-center justify-between rounded px-3 py-2 text-sm text-[var(--color-text-secondary)] transition-all hover:bg-[var(--color-bg-tertiary)] hover:text-[var(--color-text-primary)]"
            >
              <span>{tag}</span>
              <span class="rounded-full bg-[var(--color-border)] px-1.5 py-0.5 text-[10px] font-bold tabular-nums text-[var(--color-text-muted)]">
                {tagCounts[tag]}
              </span>
            </button>
          ))}
        </nav>

        {/* Сброс фильтра */}
        <button
          id="clear-filter"
          class="mt-4 hidden w-full text-left text-xs text-[var(--color-text-muted)] transition-colors hover:text-[var(--color-accent)]"
        >
          ← сбросить фильтр
        </button>
      </div>
    </aside>

    {/* Список статей */}
    <div class="min-w-0 flex-1">
      <div id="posts-container" class="grid gap-6 sm:gap-8">
        {posts.map((post, i) => (
          <article
            class="post-item scroll-reveal group rounded-lg border border-[var(--color-border)] bg-[var(--color-bg-card)] p-4 transition-all hover:border-[var(--color-accent)] hover:-translate-y-1 sm:p-6"
            style={`transition-delay: ${Math.min(i * 100, 400)}ms`}
            data-tags={post.data.tags.join(',')}
          >
            {/* Tags */}
            <div class="mb-3 flex flex-wrap gap-2">
              {post.data.tags.map(tag => (
                <a
                  href={`/blog/tag/${tag}/`}
                  class="tag-clickable rounded-full bg-[var(--color-accent)]/10 px-2 py-0.5 text-xs font-medium text-[var(--color-accent)] transition-all hover:bg-[var(--color-accent)]/20 sm:px-2.5"
                >
                  {tag}
                </a>
              ))}
            </div>

            {/* Title */}
            <h2 class="mb-2 text-xl font-bold text-[var(--color-text-primary)] transition-colors group-hover:text-[var(--color-accent)] sm:text-2xl">
              <a href={`/blog/${post.slug}/`}>
                {post.data.title}
              </a>
            </h2>

            {/* Meta */}
            <div class="mb-3 flex items-center gap-3 text-xs text-[var(--color-text-muted)]">
              <span>{formatDate(post.data.publishedAt)}</span>
              <span>•</span>
              <span>{calculateReadTime(post.body)} мин чтения</span>
            </div>

            {/* Description */}
            <p class="text-sm leading-relaxed text-[var(--color-text-secondary)]">
              {post.data.description}
            </p>
          </article>
        ))}
      </div>

      {/* Сообщение, если нет результатов */}
      <div
        id="no-results"
        class="hidden rounded-lg border border-[var(--color-border)] bg-[var(--color-bg-card)] p-12 text-center"
      >
        <p class="text-[var(--color-text-muted)]">
          Статей с выбранным тегом не найдено
        </p>
      </div>
    </div>
  </div>
</BaseLayout>

<script>
  function initBlogFilter() {
    const sidebarButtons = document.querySelectorAll<HTMLElement>('[data-btn-type="sidebar"]');
    const mobileButtons = document.querySelectorAll<HTMLElement>('[data-btn-type="mobile"]');
    const posts = document.querySelectorAll<HTMLElement>('.post-item');
    const clearButton = document.getElementById('clear-filter');
    const noResults = document.getElementById('no-results');
    const postsContainer = document.getElementById('posts-container');

    // Если кнопок фильтра нет — мы не на странице блога, выходим
    if (!sidebarButtons.length && !mobileButtons.length) return;

    function filterPosts(filter: string) {
      let visibleCount = 0;
      posts.forEach(post => {
        const tags = post.dataset.tags?.split(',') ?? [];
        if (filter === 'all' || tags.includes(filter)) {
          post.classList.remove('hidden');
          visibleCount++;
        } else {
          post.classList.add('hidden');
        }
      });

      if (visibleCount === 0) {
        postsContainer?.classList.add('hidden');
        noResults?.classList.remove('hidden');
      } else {
        postsContainer?.classList.remove('hidden');
        noResults?.classList.add('hidden');
      }
    }

    function updateSidebarButtons(filter: string) {
      sidebarButtons.forEach(btn => {
        const isActive = btn.dataset.filter === filter;
        btn.setAttribute('aria-pressed', String(isActive));
        if (isActive) {
          btn.classList.add('bg-[var(--color-accent)]/10', 'text-[var(--color-accent)]');
          btn.classList.remove('text-[var(--color-text-secondary)]');
        } else {
          btn.classList.remove('bg-[var(--color-accent)]/10', 'text-[var(--color-accent)]');
          btn.classList.add('text-[var(--color-text-secondary)]');
        }
      });
    }

    function updateMobileButtons(filter: string) {
      mobileButtons.forEach(btn => {
        const isActive = btn.dataset.filter === filter;
        btn.setAttribute('aria-pressed', String(isActive));
        if (isActive) {
          btn.classList.add('bg-[var(--color-accent)]', 'text-white');
          btn.classList.remove('bg-[var(--color-accent)]/10', 'text-[var(--color-accent)]');
        } else {
          btn.classList.remove('bg-[var(--color-accent)]', 'text-white');
          btn.classList.add('bg-[var(--color-accent)]/10', 'text-[var(--color-accent)]');
        }
      });
    }

    function setFilter(filter: string) {
      updateSidebarButtons(filter);
      updateMobileButtons(filter);
      filterPosts(filter);

      if (clearButton) {
        if (filter === 'all') {
          clearButton.classList.add('hidden');
        } else {
          clearButton.classList.remove('hidden');
        }
      }
    }

    // Навешиваем обработчики на все кнопки
    document.querySelectorAll<HTMLElement>('[data-filter]').forEach(btn => {
      btn.addEventListener('click', () => {
        const filter = btn.dataset.filter ?? 'all';
        setFilter(filter);
      });
    });

    // Кнопка сброса
    clearButton?.addEventListener('click', () => setFilter('all'));
  }

  // Запускаем при каждой навигации (включая первую загрузку)
  document.addEventListener('astro:page-load', initBlogFilter);
</script>
