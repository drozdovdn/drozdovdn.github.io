---
import BaseLayout from '../../layouts/BaseLayout.astro';
import SectionTitle from '../../components/ui/SectionTitle.astro';
import { getCollection } from 'astro:content';

// Get all blog posts
const allPosts = await getCollection('blog');

// Sort by date (newest first)
const posts = allPosts.sort((a, b) => 
  b.data.publishedAt.getTime() - a.data.publishedAt.getTime()
);

// Собираем все уникальные теги с подсчётом
const tagCounts = posts.reduce((acc, post) => {
  post.data.tags.forEach(tag => {
    acc[tag] = (acc[tag] || 0) + 1;
  });
  return acc;
}, {} as Record<string, number>);

const allTags = Object.keys(tagCounts).sort();

function formatDate(date: Date) {
  return new Intl.DateTimeFormat('ru-RU', {
    year: 'numeric',
    month: 'long',
    day: 'numeric'
  }).format(date);
}

function calculateReadTime(content: string) {
  const wordsPerMinute = 200;
  const words = content.trim().split(/\s+/).length;
  return Math.ceil(words / wordsPerMinute);
}
---

<BaseLayout title="Блог">
  <SectionTitle
    title="Блог"
    subtitle="Статьи о frontend-разработке, архитектуре и извлечённых уроках."
    filename="blog.ts"
  />

  {/* Фильтр по тегам */}
  <div class="mb-12 scroll-reveal rounded-lg border border-[var(--color-border)] bg-[var(--color-bg-card)] p-6">
    <div class="mb-4 flex items-center justify-between">
      <h3 class="text-sm font-semibold text-[var(--color-text-muted)]">🏷️ Фильтр по тегам:</h3>
      <button
        id="clear-filter"
        class="hidden text-xs text-[var(--color-accent)] transition-colors hover:text-[var(--color-accent-hover)]"
      >
        Сбросить фильтр
      </button>
    </div>
    <div class="flex flex-wrap gap-2">
      <button
        data-filter="all"
        class="filter-tag tag-clickable rounded-full bg-[var(--color-accent)] px-3 py-1.5 text-xs font-medium text-white transition-all hover:opacity-80"
      >
        Все ({posts.length})
      </button>
      {allTags.map(tag => (
        <button
          data-filter={tag}
          class="filter-tag tag-clickable rounded-full bg-[var(--color-accent)]/10 px-3 py-1.5 text-xs font-medium text-[var(--color-accent)] transition-all hover:bg-[var(--color-accent)]/20"
        >
          {tag} ({tagCounts[tag]})
        </button>
      ))}
    </div>
  </div>

  <div id="posts-container" class="grid gap-8">
    {posts.map((post, i) => (
      <article
        class="post-item scroll-reveal group rounded-lg border border-[var(--color-border)] bg-[var(--color-bg-card)] p-6 transition-all hover:border-[var(--color-accent)] hover:-translate-y-1"
        style={`transition-delay: ${i * 100}ms`}
        data-tags={post.data.tags.join(',')}
      >
        {/* Tags */}
        <div class="mb-3 flex flex-wrap gap-2">
          {post.data.tags.map(tag => (
            <a
              href={`/blog/tag/${tag}/`}
              class="tag-clickable rounded-full bg-[var(--color-accent)]/10 px-2.5 py-0.5 text-xs font-medium text-[var(--color-accent)] transition-all hover:bg-[var(--color-accent)]/20"
            >
              {tag}
            </a>
          ))}
        </div>

        {/* Title */}
        <h2 class="mb-2 text-2xl font-bold text-[var(--color-text-primary)] transition-colors group-hover:text-[var(--color-accent)]">
          <a href={`/blog/${post.slug}/`}>
            {post.data.title}
          </a>
        </h2>

        {/* Meta */}
        <div class="mb-3 flex items-center gap-3 text-xs text-[var(--color-text-muted)]">
          <span>{formatDate(post.data.publishedAt)}</span>
          <span>•</span>
          <span>{calculateReadTime(post.body)} мин чтения</span>
        </div>

        {/* Description */}
        <p class="mb-4 text-sm leading-relaxed text-[var(--color-text-secondary)]">
          {post.data.description}
        </p>

        {/* Read more */}
        <a
          href={`/blog/${post.slug}/`}
          class="inline-flex items-center gap-1 text-sm font-semibold text-[var(--color-accent)] transition-colors hover:underline"
        >
          Читать далее
          <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M13 7l5 5m0 0l-5 5m5-5H6" />
          </svg>
        </a>
      </article>
    ))}
  </div>

  {/* Сообщение, если нет результатов */}
  <div
    id="no-results"
    class="hidden rounded-lg border border-[var(--color-border)] bg-[var(--color-bg-card)] p-12 text-center"
  >
    <p class="text-[var(--color-text-muted)]">
      Статей с выбранным тегом не найдено
    </p>
  </div>
</BaseLayout>

<script>
  // Клиентская фильтрация по тегам
  const filterButtons = document.querySelectorAll('.filter-tag');
  const posts = document.querySelectorAll('.post-item');
  const clearButton = document.getElementById('clear-filter');
  const noResults = document.getElementById('no-results');
  const postsContainer = document.getElementById('posts-container');

  let activeFilter = 'all';

  filterButtons.forEach(button => {
    button.addEventListener('click', () => {
      const filter = button.getAttribute('data-filter');
      activeFilter = filter;

      // Обновляем активную кнопку
      filterButtons.forEach(btn => {
        if (btn.getAttribute('data-filter') === filter) {
          btn.classList.remove('bg-[var(--color-accent)]/10', 'text-[var(--color-accent)]');
          btn.classList.add('bg-[var(--color-accent)]', 'text-white');
        } else {
          btn.classList.remove('bg-[var(--color-accent)]', 'text-white');
          btn.classList.add('bg-[var(--color-accent)]/10', 'text-[var(--color-accent)]');
        }
      });

      // Показываем/скрываем кнопку сброса
      if (filter === 'all') {
        clearButton?.classList.add('hidden');
      } else {
        clearButton?.classList.remove('hidden');
      }

      // Фильтруем посты
      let visibleCount = 0;
      posts.forEach(post => {
        const tags = post.getAttribute('data-tags')?.split(',') || [];
        
        if (filter === 'all' || tags.includes(filter)) {
          post.classList.remove('hidden');
          visibleCount++;
        } else {
          post.classList.add('hidden');
        }
      });

      // Показываем сообщение, если нет результатов
      if (visibleCount === 0) {
        postsContainer?.classList.add('hidden');
        noResults?.classList.remove('hidden');
      } else {
        postsContainer?.classList.remove('hidden');
        noResults?.classList.add('hidden');
      }
    });
  });

  // Кнопка сброса фильтра
  clearButton?.addEventListener('click', () => {
    const allButton = document.querySelector('[data-filter="all"]');
    if (allButton instanceof HTMLElement) {
      allButton.click();
    }
  });
</script>
