---
import BaseLayout from '../layouts/BaseLayout.astro';
import SectionTitle from '../components/ui/SectionTitle.astro';
import Terminal from '../components/ui/Terminal.astro';
import { personal, socialLinks } from '../data/personal';
---

<BaseLayout title="Контакты">
  <SectionTitle
    title="Связаться"
    subtitle="Давайте обсудим frontend-архитектуру или создадим что-то отличное вместе."
    filename="contact.ts"
  />

  <div class="grid gap-12 lg:grid-cols-2">
    {/* Contact Info */}
    <div>
      {/* Email */}
      <div class="scroll-reveal mb-8">
        <h3 class="mb-3 flex items-center gap-2 text-lg font-bold text-[var(--color-text-primary)]">
          <span class="text-[var(--color-accent)]">{'>'}</span>
          Email
        </h3>
        <a
          href={`mailto:${personal.email}`}
          class="inline-flex items-center gap-2 rounded-lg border border-[var(--color-border)] bg-[var(--color-bg-card)] px-4 py-3 text-sm text-[var(--color-accent)] transition-colors hover:border-[var(--color-accent)]"
        >
          <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z" />
          </svg>
          {personal.email}
        </a>
      </div>

      {/* Social Links */}
      <div class="scroll-reveal" style="transition-delay: 100ms">
        <h3 class="mb-3 flex items-center gap-2 text-lg font-bold text-[var(--color-text-primary)]">
          <span class="text-[var(--color-accent)]">{'>'}</span>
          Социальные сети
        </h3>
        <div class="space-y-3">
          {socialLinks.map((link) => (
            <a
              href={link.url}
              target="_blank"
              rel="noopener noreferrer"
              class="flex flex-col gap-2 rounded-lg border border-[var(--color-border)] bg-[var(--color-bg-card)] px-4 py-3 text-sm text-[var(--color-text-primary)] transition-all hover:border-[var(--color-accent)] hover:text-[var(--color-accent)] hover:-translate-x-1 sm:flex-row sm:items-center sm:gap-3"
              aria-label={link.name}
            >
              <span class="font-semibold">{link.name}</span>
              <span class="hidden text-[var(--color-text-muted)] sm:inline">→</span>
              <span class="break-all text-xs text-[var(--color-text-muted)]">{link.url.replace('https://', '')}</span>
            </a>
          ))}
        </div>
      </div>

      {/* Terminal card */}
      <div class="scroll-reveal mt-8" style="transition-delay: 200ms">
        <Terminal title="~/contact $ cat availability.txt">
          <div class="space-y-1 text-sm">
            <p class="text-[var(--color-text-secondary)]">
              <span class="text-[var(--color-accent)]">Status:</span> На связи
            </p>
            <!--<p class="text-[var(&#45;&#45;color-text-secondary)]">-->
            <!--  <span class="text-[var(&#45;&#45;color-accent)]">Preferred:</span> удалённо / гибрид-->
            <!--</p>-->
            <p class="text-[var(--color-text-secondary)]">
              <span class="text-[var(--color-accent)]">Response time:</span> обычно в течение ~24 часов
            </p>
            <p class="text-[var(--color-text-secondary)]">
              <span class="text-[var(--color-accent)]">Best way:</span> Email или Telegram
            </p>
          </div>
        </Terminal>
      </div>
    </div>

    {/* Contact Form */}
    <div class="scroll-reveal" style="transition-delay: 150ms">
      <h3 class="mb-4 flex items-center gap-2 text-lg font-bold text-[var(--color-text-primary)]">
        <span class="text-[var(--color-accent)]">{'>'}</span>
        Написать сообщение
      </h3>
      <form
        id="contact-form"
        class="space-y-4 rounded-lg border border-[var(--color-border)] bg-[var(--color-bg-card)] p-6"
      >
        <div>
          <label for="name" class="mb-1.5 block text-xs text-[var(--color-text-muted)]">
            Ваше имя
          </label>
          <input
            type="text"
            id="name"
            name="name"
            required
            class="w-full rounded-lg border border-[var(--color-border)] bg-[var(--color-bg-primary)] px-4 py-2.5 text-sm text-[var(--color-text-primary)] outline-none transition-colors placeholder:text-[var(--color-text-muted)] focus:border-[var(--color-accent)]"
            placeholder="Иван Иванов"
          />
        </div>
        <div>
          <label for="email" class="mb-1.5 block text-xs text-[var(--color-text-muted)]">
            Ваш Email
          </label>
          <input
            type="email"
            id="email"
            name="email"
            required
            class="w-full rounded-lg border border-[var(--color-border)] bg-[var(--color-bg-primary)] px-4 py-2.5 text-sm text-[var(--color-text-primary)] outline-none transition-colors placeholder:text-[var(--color-text-muted)] focus:border-[var(--color-accent)]"
            placeholder="ivan@example.com"
          />
        </div>
        <div>
          <label for="message" class="mb-1.5 block text-xs text-[var(--color-text-muted)]">
            Сообщение
          </label>
          <textarea
            id="message"
            name="message"
            rows="5"
            required
            class="w-full resize-none rounded-lg border border-[var(--color-border)] bg-[var(--color-bg-primary)] px-4 py-2.5 text-sm text-[var(--color-text-primary)] outline-none transition-colors placeholder:text-[var(--color-text-muted)] focus:border-[var(--color-accent)]"
            placeholder="Ваше сообщение..."
          ></textarea>
        </div>
        
        {/* Статус отправки */}
        <div id="form-status" class="hidden rounded-lg p-3 text-sm"></div>
        
        <button
          type="submit"
          id="submit-btn"
          class="inline-flex w-full items-center justify-center gap-2 rounded-lg bg-[var(--color-accent)] px-6 py-3 text-sm font-semibold text-white transition-colors hover:bg-[var(--color-accent-hover)] disabled:opacity-50 disabled:cursor-not-allowed"
        >
          <span id="btn-text">Отправить</span>
          <svg id="btn-icon" class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M13 7l5 5m0 0l-5 5m5-5H6" />
          </svg>
        </button>
        
        <p class="text-xs text-[var(--color-text-muted)]">
          💡 Или напишите напрямую на <a href={`mailto:${personal.email}`} class="text-[var(--color-accent)] hover:underline">{personal.email}</a>
        </p>
      </form>
    </div>
  </div>
</BaseLayout>

<script>
  const form = document.getElementById('contact-form') as HTMLFormElement;
  const submitBtn = document.getElementById('submit-btn') as HTMLButtonElement;
  const btnText = document.getElementById('btn-text');
  const formStatus = document.getElementById('form-status');
  
  // Web3Forms API ключ - ПОЛУЧИТЕ СВОЙ на https://web3forms.com (бесплатно)
  // Временный тестовый ключ (замените на свой для production)
  const WEB3FORMS_KEY = '6aa576f1-1b49-496b-9a18-b9e850f07d13';
  
  form?.addEventListener('submit', async (e) => {
    e.preventDefault();
    
    const formData = new FormData(form);
    const name = formData.get('name') as string;
    const email = formData.get('email') as string;
    const message = formData.get('message') as string;
    
    // Отключаем кнопку
    submitBtn.disabled = true;
    if (btnText) btnText.textContent = 'Отправка...';
    
    // Показываем статус
    if (formStatus) {
      formStatus.classList.remove('hidden', 'bg-green-500/10', 'text-green-400', 'bg-red-500/10', 'text-red-400');
      formStatus.classList.add('bg-[var(--color-accent)]/10', 'text-[var(--color-accent)]');
      formStatus.textContent = 'Отправка сообщения...';
    }
    
    try {
      // Отправка через Web3Forms API
      const response = await fetch('https://api.web3forms.com/submit', {
        method: 'POST',
        headers: {
          'Content-Type': 'application/json',
          'Accept': 'application/json',
        },
        body: JSON.stringify({
          access_key: WEB3FORMS_KEY,
          name: name,
          email: email,
          message: message,
          subject: `Новое сообщение от ${name}`,
          from_name: name,
          replyto: email,
        }),
      });
      
      const result = await response.json();
      
      if (result.success) {
        // Успешная отправка
        if (formStatus) {
          formStatus.classList.remove('bg-[var(--color-accent)]/10', 'text-[var(--color-accent)]');
          formStatus.classList.add('bg-green-500/10', 'text-green-400');
          formStatus.textContent = '✅ Сообщение успешно отправлено! Отвечу в течение 24 часов.';
        }
        form.reset();
      } else {
        throw new Error(result.message || 'Failed to send');
      }
    } catch (error) {
      console.error('Error:', error);
      
      if (formStatus) {
        formStatus.classList.remove('bg-[var(--color-accent)]/10', 'text-[var(--color-accent)]');
        formStatus.classList.add('bg-red-500/10', 'text-red-400');
        
        // Проверяем, если ошибка связана с ключом
        const errorMsg = (error as Error).message || '';
        if (errorMsg.includes('access_key') || errorMsg.includes('401')) {
          formStatus.innerHTML = '⚠️ Требуется настройка Web3Forms API ключа.<br/>Инструкция: откройте файл <code class="text-xs">CONTACT_FORM_SETUP.md</code>';
        } else {
          formStatus.textContent = '❌ Не удалось отправить. Попробуйте написать напрямую на email.';
        }
      }
    }
    
    if (btnText) btnText.textContent = 'Отправить';
    submitBtn.disabled = false;
  });
</script>
