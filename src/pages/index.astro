---
import BaseLayout from '../layouts/BaseLayout.astro';
import Terminal from '../components/ui/Terminal.astro';
import TypingEffect from '../components/ui/TypingEffect.astro';
import MatrixRain from '../components/ui/MatrixRain.astro';
import { getCollection } from 'astro:content';
import { navItems } from '../data/navigation';

const terminalLines = [
  { text: 'const engineer = new SeniorFrontendEngineer();' },
  { text: 'engineer.focus = ["architecture", "performance", "scalability"];' },
  { text: 'engineer.experience = "5+ лет";' },
  { text: 'engineer.learning = "web security";' },
  { text: 'console.log(engineer.build());' },
  { text: '→ Готов создавать масштабируемые, производительные и безопастные решения.', isOutput: true },
];

// Проверяем, видим ли раздел "Блог" в навигации
const blogNavItem = navItems.find(item => item.path === '/blog/');
const showBlogSection = blogNavItem?.visible ?? false;

// Получаем последние статьи блога (только если раздел блога видим)
let latestPosts: any[] = [];
if (showBlogSection) {
  const allPosts = await getCollection('blog');
  latestPosts = allPosts
    .sort((a, b) => b.data.publishedAt.getTime() - a.data.publishedAt.getTime())
    .slice(0, 3);
}

function formatDate(date: Date) {
  return new Intl.DateTimeFormat('ru-RU', {
    year: 'numeric',
    month: 'long',
    day: 'numeric'
  }).format(date);
}
---

<BaseLayout title="Главная">
  <MatrixRain />

  {/* ===== HERO SECTION ===== */}
  <section class="relative z-10 flex min-h-[70vh] flex-col justify-center py-12">
    {/* Decorative line numbers */}
    <div class="absolute left-0 top-12 hidden text-[10px] leading-[2.4] text-[var(--color-text-muted)] opacity-30 lg:block">
      {Array.from({ length: 20 }, (_, i) => (
        <div>{String(i + 1).padStart(2, '0')}</div>
      ))}
    </div>

    <div class="lg:pl-12">
      {/* Greeting */}
      <p class="mb-2 text-sm text-[var(--color-accent)]">
        {'// '}Hello, World!
      </p>

      {/* Name */}
      <h1
        class="glitch-hover mb-2 text-4xl font-bold text-[var(--color-text-primary)] sm:text-5xl lg:text-6xl"
        data-text="Дмитрий Дроздов"
      >
        Дмитрий Дроздов
      </h1>

      {/* Role */}
      <h2 class="mb-4 text-xl text-[var(--color-accent)] sm:text-2xl">
        Senior Frontend Engineer
      </h2>

      {/* Subtitle */}
      <p class="mb-6 max-w-xl text-sm leading-relaxed text-[var(--color-text-secondary)] sm:mb-8 sm:text-base">
        Делаю фронтенд, который переживает рост продукта: архитектура, поддерживаемость, контроль сложности и стабильные изменения. <br class="hidden sm:inline"/>
        Системно работаю с производительностью и развиваюсь в направлении веб-безопасности.
      </p>

      {/* Terminal */}
      <Terminal title="~/portfolio $ node intro.js" class="mb-8 max-w-2xl">
        <TypingEffect lines={terminalLines} id="hero-typing" />
      </Terminal>

      {/* CTAs */}
      <div class="flex flex-wrap gap-4">
        <a
          href="/experience/"
          class="inline-flex items-center gap-2 rounded-lg bg-[var(--color-accent)] px-6 py-3 text-sm font-semibold text-white transition-colors hover:bg-[var(--color-accent-hover)]"
        >
          Смотреть опыт
          <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M13 7l5 5m0 0l-5 5m5-5H6" />
          </svg>
        </a>
        <a
          href="/contact/"
          class="inline-flex items-center gap-2 rounded-lg border border-[var(--color-border)] bg-[var(--color-bg-secondary)] px-6 py-3 text-sm font-semibold text-[var(--color-text-primary)] transition-colors hover:border-[var(--color-accent)] hover:text-[var(--color-accent)]"
        >
          Связаться
        </a>
      </div>
    </div>
  </section>

  {/* ===== ABOUT SECTION ===== */}
  <section class="relative z-10 py-16" id="about">
    <div class="scroll-reveal mb-8">
      <span class="mb-2 block text-xs text-[var(--color-text-muted)]">{'// about.ts'}</span>
      <h2 class="text-3xl font-bold text-[var(--color-text-primary)]">
        <span class="text-[var(--color-accent)]">{'{ '}</span>
        Обо мне
        <span class="text-[var(--color-accent)]">{' }'}</span>
      </h2>
      <div class="mt-4 h-px w-24 bg-gradient-to-r from-[var(--color-accent)] to-transparent"></div>
    </div>

    <div class="grid gap-8 lg:grid-cols-3">
      {/* Text content */}
      <div class="space-y-4 lg:col-span-2">
        <p class="scroll-reveal text-sm leading-relaxed text-[var(--color-text-secondary)]">
          Senior Frontend Engineer с 5+ годами опыта создания масштабируемых веб-приложений. Специализация — frontend-архитектура, системный дизайн и высокопроизводительные решения на React, TypeScript и современных инструментах.
        </p>
        <p class="scroll-reveal text-sm leading-relaxed text-[var(--color-text-secondary)]" style="transition-delay: 100ms">
          Увлекаюсь чистым кодом, компонентным подходом и надёжными решениями. В свободное время решаю CTF-задачи на платформах безопасности — прошёл курс по веб-пентестингу и активно практикуюсь.
        </p>
        <p class="scroll-reveal text-sm leading-relaxed text-[var(--color-text-secondary)]" style="transition-delay: 200ms">
          Фокус на архитектурных решениях, балансирующих масштабируемость, поддерживаемость и удобство для разработчиков.
        </p>
      </div>

      {/* Info cards */}
      <div class="space-y-3 sm:space-y-4">
        {[
          { label: 'Локация', value: 'Россия', icon: '📍' },
          { label: 'Языки', value: 'Русский', icon: '🌐' },
          { label: 'Текущий фокус', value: 'Frontend-архитектура и веб-безопасность', icon: '🎯' },
        ].map((info, i) => (
          <div
            class="scroll-reveal rounded-lg border border-[var(--color-border)] bg-[var(--color-bg-card)] p-3 transition-colors hover:border-[var(--color-border-hover)] sm:p-4"
            style={`transition-delay: ${i * 100}ms`}
          >
            <div class="mb-1 text-xs text-[var(--color-text-muted)]">{info.label}</div>
            <div class="text-xs font-semibold text-[var(--color-text-primary)] sm:text-sm">{info.value}</div>
          </div>
        ))}
      </div>
    </div>
  </section>

  {/* ===== BLOG SECTION ===== */}
  {showBlogSection && (
    <section class="relative z-10 py-16" id="blog">
      <div class="scroll-reveal mb-8">
        <span class="mb-2 block text-xs text-[var(--color-text-muted)]">{'// blog.ts'}</span>
        <div class="flex items-center justify-between">
          <h2 class="text-3xl font-bold text-[var(--color-text-primary)]">
            <span class="text-[var(--color-accent)]">{'{ '}</span>
            Последние статьи
            <span class="text-[var(--color-accent)]">{' }'}</span>
          </h2>
          <a
            href="/blog/"
            class="text-sm text-[var(--color-accent)] transition-colors hover:text-[var(--color-accent-hover)]"
          >
            Все статьи →
          </a>
        </div>
        <div class="mt-4 h-px w-24 bg-gradient-to-r from-[var(--color-accent)] to-transparent"></div>
      </div>

      <div class="grid gap-6 md:grid-cols-3">
        {latestPosts.map((post, i) => (
          <article
            class="scroll-reveal group rounded-lg border border-[var(--color-border)] bg-[var(--color-bg-card)] p-5 transition-all hover:border-[var(--color-accent)] hover:-translate-y-1"
            style={`transition-delay: ${i * 100}ms`}
          >
            {/* Tags */}
            <div class="mb-3 flex flex-wrap gap-2">
              {post.data.tags.slice(0, 2).map(tag => (
                <span class="rounded-full bg-[var(--color-accent)]/10 px-2 py-0.5 text-xs font-medium text-[var(--color-accent)]">
                  {tag}
                </span>
              ))}
            </div>

            {/* Title */}
            <h3 class="mb-2 text-lg font-bold text-[var(--color-text-primary)] transition-colors group-hover:text-[var(--color-accent)]">
              <a href={`/blog/${post.slug}/`}>
                {post.data.title}
              </a>
            </h3>

            {/* Date */}
            <p class="mb-3 text-xs text-[var(--color-text-muted)]">
              {formatDate(post.data.publishedAt)}
            </p>

            {/* Description */}
            <p class="mb-4 line-clamp-2 text-sm text-[var(--color-text-secondary)]">
              {post.data.description}
            </p>

            {/* Read more */}
            <a
              href={`/blog/${post.slug}/`}
              class="inline-flex items-center gap-1 text-xs font-semibold text-[var(--color-accent)] transition-colors hover:underline"
            >
              Читать далее
              <svg class="h-3 w-3" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                <path stroke-linecap="round" stroke-linejoin="round" d="M13 7l5 5m0 0l-5 5m5-5H6" />
              </svg>
            </a>
          </article>
        ))}
      </div>

      {/* CTA для блога */}
      <div class="scroll-reveal mt-12 text-center" style="transition-delay: 300ms">
        <a
          href="/blog/"
          class="inline-flex items-center gap-2 rounded-lg border border-[var(--color-border)] bg-[var(--color-bg-secondary)] px-6 py-3 text-sm font-semibold text-[var(--color-text-primary)] transition-all hover:border-[var(--color-accent)] hover:text-[var(--color-accent)] hover:-translate-y-1"
        >
          📚 Смотреть все статьи блога
          <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M13 7l5 5m0 0l-5 5m5-5H6" />
          </svg>
        </a>
      </div>
    </section>
  )}
</BaseLayout>
