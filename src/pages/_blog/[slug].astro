---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';
import { formatDate, calculateReadTime } from '../../utils/blog';

export async function getStaticPaths() {
  const posts = await getCollection('blog');
  const sorted = posts.sort((a, b) => b.data.publishedAt.getTime() - a.data.publishedAt.getTime());

  return sorted.map((post, i) => ({
    params: { slug: post.slug },
    props: {
      post,
      prevPost: sorted[i + 1] ?? null,
      nextPost: sorted[i - 1] ?? null,
    },
  }));
}

const { post, prevPost, nextPost } = Astro.props;
const { Content } = await post.render();
---

<BaseLayout title={post.data.title} description={post.data.description}>
  {/* Reading progress bar */}
  <div
    id="reading-progress"
    class="fixed left-0 top-0 z-[60] h-0.5 w-0 bg-[var(--color-accent)]"
    style="transition: width 0.1s linear;"
  ></div>

  <article class="mx-auto max-w-3xl">
    {/* Back button */}
    <a
      href="/blog/"
      class="mb-8 inline-flex items-center gap-2 text-sm text-[var(--color-text-muted)] transition-colors hover:text-[var(--color-accent)]"
    >
      <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
        <path stroke-linecap="round" stroke-linejoin="round" d="M10 19l-7-7m0 0l7-7m-7 7h18" />
      </svg>
      Все статьи
    </a>

    {/* Tags */}
    <div class="mb-4 flex flex-wrap gap-2">
      {post.data.tags.map(tag => (
        <a
          href={`/blog/tag/${tag}/`}
          class="tag-clickable rounded-full bg-[var(--color-accent)]/10 px-2.5 py-0.5 text-xs font-medium text-[var(--color-accent)] transition-all hover:bg-[var(--color-accent)]/20"
        >
          {tag}
        </a>
      ))}
    </div>

    {/* Title */}
    <h1 class="mb-4 text-4xl font-bold text-[var(--color-text-primary)] sm:text-5xl">
      {post.data.title}
    </h1>

    {/* Meta */}
    <div class="mb-8 flex items-center gap-3 text-sm text-[var(--color-text-muted)]">
      <span>{formatDate(post.data.publishedAt)}</span>
      <span>•</span>
      <span>{calculateReadTime(post.body)} мин чтения</span>
    </div>

    {/* Content */}
    <div class="prose prose-invert max-w-none">
      <Content />
    </div>

    {/* Prev / Next navigation */}
    {(prevPost || nextPost) && (
      <nav class="mt-16 border-t border-[var(--color-border)] pt-8 grid grid-cols-2 gap-4">
        <div>
          {prevPost && (
            <a
              href={`/blog/${prevPost.slug}/`}
              class="group flex flex-col gap-1 rounded-lg border border-[var(--color-border)] bg-[var(--color-bg-card)] p-4 transition-all hover:border-[var(--color-accent)] hover:-translate-y-0.5"
            >
              <span class="text-xs text-[var(--color-text-muted)]">← Предыдущая</span>
              <span class="text-sm font-medium text-[var(--color-text-primary)] group-hover:text-[var(--color-accent)] transition-colors line-clamp-2">
                {prevPost.data.title}
              </span>
            </a>
          )}
        </div>
        <div>
          {nextPost && (
            <a
              href={`/blog/${nextPost.slug}/`}
              class="group flex flex-col gap-1 rounded-lg border border-[var(--color-border)] bg-[var(--color-bg-card)] p-4 text-right transition-all hover:border-[var(--color-accent)] hover:-translate-y-0.5"
            >
              <span class="text-xs text-[var(--color-text-muted)]">Следующая →</span>
              <span class="text-sm font-medium text-[var(--color-text-primary)] group-hover:text-[var(--color-accent)] transition-colors line-clamp-2">
                {nextPost.data.title}
              </span>
            </a>
          )}
        </div>
      </nav>
    )}
  </article>
</BaseLayout>

<script is:inline>
  (function () {
    var DARK = {
      primaryColor: '#1a1a1a',
      primaryTextColor: '#e5e5e5',
      primaryBorderColor: '#e8622c',
      lineColor: '#e8622c',
      secondaryColor: '#141414',
      tertiaryColor: '#141414',
      background: '#141414',
      mainBkg: '#1a1a1a',
      nodeBorder: '#e8622c',
      clusterBkg: '#141414',
      clusterBorder: '#262626',
      titleColor: '#e5e5e5',
      edgeLabelBackground: '#141414',
      fontFamily: 'JetBrains Mono, monospace',
      fontSize: '13px',
    };

    var LIGHT = {
      primaryColor: '#f8f8f8',
      primaryTextColor: '#0f0f0f',
      primaryBorderColor: '#d94c10',
      lineColor: '#d94c10',
      secondaryColor: '#f0f0f0',
      tertiaryColor: '#f0f0f0',
      background: '#ffffff',
      mainBkg: '#f8f8f8',
      nodeBorder: '#d94c10',
      clusterBkg: '#f8f8f8',
      clusterBorder: '#e0e0e0',
      titleColor: '#0f0f0f',
      edgeLabelBackground: '#ffffff',
      fontFamily: 'JetBrains Mono, monospace',
      fontSize: '13px',
    };

    async function runMermaid() {
      var els = document.querySelectorAll('.mermaid:not([data-processed])');
      if (!els.length) return;

      var mermaid = window._mermaidModule;
      if (!mermaid) {
        var mod = await import('https://cdn.jsdelivr.net/npm/mermaid@11/dist/mermaid.esm.min.mjs');
        mermaid = mod.default;
        window._mermaidModule = mermaid;
      }

      var isLight = document.documentElement.classList.contains('light');
      mermaid.initialize({
        startOnLoad: false,
        theme: 'base',
        themeVariables: isLight ? LIGHT : DARK,
        flowchart: { curve: 'basis', padding: 20 },
        stateDiagram: { padding: 20 },
      });

      await mermaid.run({ querySelector: '.mermaid:not([data-processed])' });
    }

    if (!window._mermaidListenerAdded) {
      window._mermaidListenerAdded = true;
      document.addEventListener('astro:page-load', runMermaid);
    }
  })();
</script>

<script is:inline>
  (function () {
    var bar = document.getElementById('reading-progress');
    if (!bar) return;

    window.addEventListener('scroll', function () {
      var scrollTop = window.scrollY;
      var docHeight = document.body.scrollHeight - window.innerHeight;
      var progress = docHeight > 0 ? (scrollTop / docHeight) * 100 : 0;
      bar.style.width = Math.min(progress, 100) + '%';
    }, { passive: true });
  })();
</script>

<script is:inline>
  (function () {
    document.querySelectorAll('.prose pre').forEach(function (pre) {
      var wrapper = document.createElement('div');
      wrapper.style.position = 'relative';
      pre.parentNode.insertBefore(wrapper, pre);
      wrapper.appendChild(pre);

      var btn = document.createElement('button');
      btn.textContent = 'копировать';
      btn.setAttribute('aria-label', 'Скопировать код');
      btn.style.cssText = [
        'position:absolute',
        'top:0.5rem',
        'right:0.5rem',
        'padding:0.2rem 0.6rem',
        'font-size:0.7rem',
        'font-family:inherit',
        'background:var(--color-bg-tertiary)',
        'color:var(--color-text-muted)',
        'border:1px solid var(--color-border)',
        'border-radius:0.25rem',
        'cursor:pointer',
        'transition:color 0.2s,border-color 0.2s',
        'opacity:0',
        'transition:opacity 0.2s,color 0.2s,border-color 0.2s',
      ].join(';');

      wrapper.addEventListener('mouseenter', function () { btn.style.opacity = '1'; });
      wrapper.addEventListener('mouseleave', function () { btn.style.opacity = '0'; });

      btn.addEventListener('click', function () {
        var code = pre.querySelector('code');
        var text = code ? code.innerText : pre.innerText;
        navigator.clipboard.writeText(text).then(function () {
          btn.textContent = 'скопировано!';
          btn.style.color = 'var(--color-accent)';
          btn.style.borderColor = 'var(--color-accent)';
          setTimeout(function () {
            btn.textContent = 'копировать';
            btn.style.color = 'var(--color-text-muted)';
            btn.style.borderColor = 'var(--color-border)';
          }, 2000);
        });
      });

      wrapper.appendChild(btn);
    });
  })();
</script>

<style is:global>
  /* Prose styles for blog content */
  .prose {
    color: var(--color-text-secondary);
    line-height: 1.75;
  }

  .prose h2 {
    color: var(--color-text-primary);
    font-size: 1.875rem;
    font-weight: 700;
    margin-top: 2.5rem;
    margin-bottom: 1rem;
  }

  .prose h3 {
    color: var(--color-text-primary);
    font-size: 1.5rem;
    font-weight: 600;
    margin-top: 2rem;
    margin-bottom: 0.75rem;
  }

  .prose p {
    margin-bottom: 1.25rem;
  }

  .prose ul, .prose ol {
    margin-bottom: 1.25rem;
    padding-left: 1.5rem;
  }

  .prose li {
    margin-bottom: 0.5rem;
  }

  .prose strong {
    color: var(--color-text-primary);
    font-weight: 600;
  }

  .prose code {
    color: var(--color-accent);
    background: var(--color-bg-secondary);
    padding: 0.125rem 0.375rem;
    border-radius: 0.25rem;
    font-size: 0.875em;
    font-family: var(--font-mono);
  }

  .prose pre {
    background: var(--color-bg-secondary) !important;
    border: 1px solid var(--color-border);
    border-radius: 0.5rem;
    padding: 1.25rem;
    margin: 1.5rem 0;
    overflow-x: auto;
  }

  .prose pre code {
    background: transparent;
    padding: 0;
    font-size: 0.875rem;
    line-height: 1.6;
  }

  /* Wire up Shiki dark theme for class-based theming */
  html:not(.light) .prose .astro-code span {
    color: var(--shiki-dark) !important;
  }

  html:not(.light) .prose .astro-code {
    background-color: var(--color-bg-secondary) !important;
  }

  html.light .prose .astro-code {
    background-color: #f6f8fa !important;
  }

  /* Light theme specific styles for better code readability */
  html.light .prose {
    color: var(--color-text-secondary);
  }

  html.light .prose code {
    background: #f6f8fa;
    color: #c7254e;
    border: 1px solid #e1e4e8;
    font-weight: 500;
  }

  html.light .prose pre {
    background: #f6f8fa !important;
    border: 1px solid #e1e4e8;
    box-shadow: 0 1px 2px rgba(0, 0, 0, 0.04);
  }

  html.light .prose pre code {
    border: none;
    font-weight: 400;
  }

  html.light .prose blockquote {
    color: var(--color-text-secondary);
    background: #f6f8fa;
    padding: 1rem 1rem 1rem 1.5rem;
    border-radius: 0.25rem;
    border-left-color: var(--color-accent);
  }

  html.light .prose strong {
    color: #0f0f0f;
    font-weight: 600;
  }

  html.light .prose h2,
  html.light .prose h3 {
    color: #0f0f0f;
  }

  /* Dark theme code styles for consistency */
  html:not(.light) .prose pre {
    background: var(--color-bg-secondary) !important;
    border: 1px solid var(--color-border);
  }

  html:not(.light) .prose code {
    color: var(--color-accent);
    background: var(--color-bg-secondary);
    border: 1px solid var(--color-border);
  }

  html:not(.light) .prose pre code {
    background: transparent;
    border: none;
  }

  /* Mermaid diagram container */
  .prose .mermaid {
    background: var(--color-bg-secondary);
    border: 1px solid var(--color-border);
    border-radius: 0.5rem;
    padding: 1.5rem;
    margin: 1.5rem 0;
    display: flex;
    justify-content: center;
    overflow-x: auto;
  }

  .prose .mermaid svg {
    max-width: 100%;
    height: auto;
  }

  .prose a {
    color: var(--color-accent);
    text-decoration: underline;
    transition: opacity 0.2s;
  }

  .prose a:hover {
    opacity: 0.8;
  }

  .prose blockquote {
    border-left: 3px solid var(--color-accent);
    padding-left: 1rem;
    margin: 1.5rem 0;
    font-style: italic;
    color: var(--color-text-muted);
  }
</style>
