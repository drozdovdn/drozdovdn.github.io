---
import BaseLayout from '../layouts/BaseLayout.astro';
import SectionTitle from '../components/ui/SectionTitle.astro';
import Terminal from '../components/ui/Terminal.astro';
import { skillProjects } from '../data/skills';
import { education, certifications } from '../data/education';
---

<BaseLayout title="Обучение">
  <SectionTitle
    title="Обучение и развитие"
    subtitle="Профессиональные курсы, практика и академическое образование."
    filename="ls -la training/"
  />

  {/* ===== ПРОФЕССИОНАЛЬНЫЕ КУРСЫ С ТЕХНОЛОГИЯМИ ===== */}
  <div class="mb-16">
    <h2 class="mb-6 flex items-center gap-2 text-xl font-bold text-[var(--color-text-primary)]">
      <span class="text-[var(--color-accent)]">{'>'}</span>
      Профессиональные курсы и практика
    </h2>
    
    <div class="space-y-6">
      {skillProjects.map((project, idx) => (
        <div class="scroll-reveal" style={`transition-delay: ${idx * 100}ms`}>
          <Terminal title={`~/learning $ cat ./${project.category}.txt`}>
            {/* Bash-style comment */}
            <div class="mb-3 font-mono text-xs text-[var(--color-text-muted)]">
              # {project.category.toUpperCase()} STACK
            </div>

            {/* Project Title */}
            <h3 class="mb-3 font-mono text-base font-semibold text-[var(--color-accent)]">
              {'>> '}{project.title}
            </h3>

            {/* Description - terminal style output */}
            <div class="mb-4 space-y-1 font-mono text-xs leading-relaxed text-[var(--color-text-secondary)]">
              {project.description.split('. ').map((sentence, i) => (
                sentence.trim() && (
                  <div class="flex gap-2">
                    <span class="text-[var(--color-text-muted)]">│</span>
                    <span>{sentence.trim()}{sentence.includes('.') ? '' : '.'}</span>
                  </div>
                )
              ))}
            </div>

            {/* Separator */}
            <div class="mb-3 border-t border-[var(--color-border)] pt-3"></div>

            {/* Technologies - grep-style output */}
            <div class="mb-2 font-mono text-xs text-[var(--color-text-muted)]">
              $ grep -i "technologies" {project.category}.txt
            </div>
            <div class="flex flex-wrap gap-2">
              {project.technologies.map((tech, techIdx) => (
                <span class="font-mono text-xs text-[var(--color-text-primary)]">
                  <span class="text-[var(--color-text-muted)]">[{String(techIdx + 1).padStart(2, '0')}]</span>{' '}
                  <span class="transition-colors hover:text-[var(--color-accent)]">{tech}</span>
                </span>
              ))}
            </div>

            {/* Footer */}
            <div class="mt-3 border-t border-[var(--color-border)] pt-2 font-mono text-xs text-[var(--color-text-muted)]">
              {project.technologies.length} technologies loaded
            </div>
          </Terminal>
        </div>
      ))}
    </div>

    {/* Summary */}
    <div class="scroll-reveal mt-8" style="transition-delay: 400ms">
      <Terminal title="~/learning $ ls -lh && wc -l">
        <div class="space-y-1 font-mono text-xs">
          {skillProjects.map((project, idx) => (
            <div class="text-[var(--color-text-muted)]">
              <span class="text-[var(--color-accent)]">-rw-r--r--</span>
              {' '}1 user staff{' '}
              <span class="text-[var(--color-text-primary)]">{project.technologies.length.toString().padStart(2, ' ')}</span>
              {' '}tech{' '}
              {project.category}.txt
            </div>
          ))}
          <div class="mt-2 border-t border-[var(--color-border)] pt-2 text-[var(--color-text-muted)]">
            total: {skillProjects.length} projects, {skillProjects.reduce((sum, p) => sum + p.technologies.length, 0)} technologies
          </div>
        </div>
      </Terminal>
    </div>
  </div>

  {/* ===== АКАДЕМИЧЕСКОЕ ОБРАЗОВАНИЕ ===== */}
  <div class="mb-16">
    <h2 class="mb-6 flex items-center gap-2 text-xl font-bold text-[var(--color-text-primary)]">
      <span class="text-[var(--color-accent)]">{'>'}</span>
      Академическое образование
    </h2>
    <div class="space-y-6">
      {education.map((edu, i) => (
        <div
          class="scroll-reveal rounded-lg border border-[var(--color-border)] bg-[var(--color-bg-card)] p-6 transition-colors hover:border-[var(--color-border-hover)]"
          style={`transition-delay: ${i * 120}ms`}
        >
          <div class="mb-3 flex flex-col gap-1 sm:flex-row sm:items-center sm:justify-between">
            <div>
              <h3 class="text-lg font-bold text-[var(--color-text-primary)]">{edu.institution}</h3>
              <p class="text-sm text-[var(--color-accent)]">{edu.degree}</p>
            </div>
            <span class="rounded-full bg-[var(--color-bg-tertiary)] px-3 py-1 text-xs text-[var(--color-text-muted)]">
              {edu.period}
            </span>
          </div>
          <p class="text-sm text-[var(--color-text-secondary)]">{edu.description}</p>
        </div>
      ))}
    </div>
  </div>

  {/* ===== СЕРТИФИКАТЫ ===== */}
  {certifications.length > 0 && (
    <div>
      <h2 class="mb-6 flex items-center gap-2 text-xl font-bold text-[var(--color-text-primary)]">
        <span class="text-[var(--color-accent)]">{'>'}</span>
        Сертификаты
      </h2>
      <div class="grid gap-4 sm:grid-cols-2">
        {certifications.map((cert, i) => (
          <div
            class="scroll-reveal rounded-lg border border-[var(--color-border)] bg-[var(--color-bg-card)] p-5 transition-all hover:border-[var(--color-border-hover)] hover:-translate-y-1"
            style={`transition-delay: ${i * 100}ms`}
          >
            <div class="mb-2 flex items-center justify-between">
              <h3 class="text-lg font-bold text-[var(--color-accent)]">{cert.name}</h3>
              <span class="text-xs text-[var(--color-text-muted)]">{cert.year}</span>
            </div>
            <p class="mb-2 text-xs font-semibold text-[var(--color-text-muted)]">{cert.issuer}</p>
            <p class="mb-3 text-sm text-[var(--color-text-secondary)]">{cert.description}</p>
            {cert.url && (
              <a
                href={cert.url}
                target="_blank"
                rel="noopener noreferrer"
                class="inline-flex items-center gap-1 text-xs text-[var(--color-accent)] transition-colors hover:text-[var(--color-accent-hover)]"
              >
                Подробнее
                <svg class="h-3 w-3" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14" />
                </svg>
              </a>
            )}
          </div>
        ))}
      </div>
    </div>
  )}
</BaseLayout>
